{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecturalboundary.example/schemas/issue-131-candidate-contract-v1.json",
  "title": "Issue 131 minimum candidate contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "representation_version", "repository", "purpose_scope", "accepted_inputs", "valid_transformations", "produced_outputs", "invariants_prohibitions", "evidence_provenance", "failure_semantics", "authority_boundary", "handoff"],
  "properties": {
    "contract_id": {"type": "string", "minLength": 1},
    "representation_version": {"const": "issue-131-minimum-v1"},
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "revision"],
      "properties": {"identity": {"type": "string", "minLength": 1}, "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
    },
    "purpose_scope": {"type": "string", "minLength": 1},
    "accepted_inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "valid_transformations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "produced_outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "invariants_prohibitions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "failure_semantics": {
      "type": "object", "additionalProperties": false, "required": ["null", "blocked"],
      "properties": {"null": {"type": "string", "minLength": 1}, "blocked": {"type": "string", "minLength": 1}}
    },
    "authority_boundary": {"type": "string", "minLength": 1},
    "handoff": {"type": "string", "minLength": 1}
  }
}
