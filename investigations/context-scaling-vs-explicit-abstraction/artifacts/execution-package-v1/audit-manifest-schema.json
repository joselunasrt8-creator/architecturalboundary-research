{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    { "$ref": "#/$defs/pre_execution" },
    { "$ref": "#/$defs/source_execution" },
    { "$ref": "#/$defs/target_execution" }
  ],
  "properties": {
    "run_identifiers": {},
    "hashes": {},
    "token_accounting": {},
    "model_binding": {},
    "response": {},
    "evaluator": {},
    "condition_order": {},
    "credential_boundary": {},
    "operator_actions": {},
    "scorer_image_sha256": {}
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "null_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "NULL" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_sha256", "request_sha256", "raw_response_sha256"],
      "properties": {
        "package_sha256": { "$ref": "#/$defs/sha256" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "raw_response_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "token_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplied_source_unit_ids",
        "supplied_source_unit_hashes",
        "retained_object_inventory",
        "abstraction_slot_inventory",
        "rendered_input_sha256",
        "tokenizer",
        "token_count",
        "token_ceiling",
        "budget_result",
        "model_output_tokens",
        "source_prompt_sha256",
        "target_prompt_sha256",
        "package_record_sha256",
        "target_record_sha256"
      ],
      "properties": {
        "supplied_source_unit_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^U0(0[1-9]|1[0-6])$" }
        },
        "supplied_source_unit_hashes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "retained_object_inventory": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "abstraction_slot_inventory": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "rendered_input_sha256": { "$ref": "#/$defs/sha256" },
        "tokenizer": { "const": "tiktoken==0.9.0/o200k_base" },
        "token_count": { "type": "integer", "minimum": 0 },
        "token_ceiling": { "enum": [4096, 8192] },
        "budget_result": { "const": true },
        "model_output_tokens": { "type": "integer", "minimum": 0, "maximum": 2048 },
        "source_prompt_sha256": { "$ref": "#/$defs/sha256" },
        "target_prompt_sha256": { "$ref": "#/$defs/sha256" },
        "package_record_sha256": { "$ref": "#/$defs/sha256" },
        "target_record_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "decoding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature",
        "top_p",
        "max_output_tokens",
        "presence_penalty",
        "frequency_penalty",
        "seed",
        "omitted_optional_parameters"
      ],
      "properties": {
        "temperature": { "const": 0 },
        "top_p": { "const": 1 },
        "max_output_tokens": { "const": 2048 },
        "presence_penalty": { "const": 0 },
        "frequency_penalty": { "const": 0 },
        "seed": { "const": 20260719 },
        "omitted_optional_parameters": { "const": true }
      }
    },
    "supplied_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identifier", "sha256", "content"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["source_unit", "source_response", "citation_identifier", "retained_object"]
        },
        "identifier": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "content": { "type": "string", "minLength": 1 }
      }
    },
    "canonical_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "system_prompt",
        "rendered_user_prompt",
        "supplied_inputs",
        "model",
        "decoding",
        "tools",
        "tool_choice"
      ],
      "properties": {
        "endpoint": { "const": "https://api.openai.com/v1/responses" },
        "system_prompt": { "type": "string", "minLength": 1 },
        "rendered_user_prompt": { "type": "string", "minLength": 1 },
        "supplied_inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/supplied_input" }
        },
        "model": { "const": "gpt-4.1-2025-04-14" },
        "decoding": { "$ref": "#/$defs/decoding" },
        "tools": { "type": "array", "maxItems": 0 },
        "tool_choice": { "const": "none" }
      }
    },
    "model_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "request_sha256", "started_at", "ended_at"],
      "properties": {
        "request": { "$ref": "#/$defs/canonical_request" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" }
      }
    },
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_response_sha256",
        "retained_raw_response_utf8",
        "immutable_artifact_reference",
        "parsed_final_response",
        "parsed_final_response_sha256",
        "abstraction_artifact",
        "abstraction_artifact_sha256",
        "stage1_output_hash"
      ],
      "properties": {
        "raw_response_sha256": { "$ref": "#/$defs/sha256" },
        "retained_raw_response_utf8": { "type": ["string", "null"] },
        "immutable_artifact_reference": {
          "anyOf": [{ "$ref": "#/$defs/artifact_reference" }, { "type": "null" }]
        },
        "parsed_final_response": { "type": "string", "minLength": 1 },
        "parsed_final_response_sha256": { "$ref": "#/$defs/sha256" },
        "abstraction_artifact": { "type": ["string", "null"] },
        "abstraction_artifact_sha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "stage1_output_hash": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        }
      },
      "oneOf": [
        {
          "properties": {
            "retained_raw_response_utf8": { "type": "string", "minLength": 1 },
            "immutable_artifact_reference": { "type": "null" }
          }
        },
        {
          "properties": {
            "retained_raw_response_utf8": { "type": "null" },
            "immutable_artifact_reference": { "$ref": "#/$defs/artifact_reference" }
          }
        }
      ]
    },
    "condition_order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "condition_id"],
      "properties": {
        "position": { "type": "integer", "minimum": 1, "maximum": 4 },
        "condition_id": { "type": "string", "enum": ["C1", "C2", "C3", "C4"] }
      }
    },
    "credential_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_count", "retry"],
      "properties": {
        "request_count": { "const": 1 },
        "retry": { "const": false }
      }
    },
    "operator_actions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "recorded_at"],
        "properties": {
          "action": { "type": "string", "enum": ["request", "response_retained", "offline_evaluation"] },
          "recorded_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "raw_output_sha256",
        "answer_key_sha256",
        "scope_rubric_sha256",
        "KEY_MATCH",
        "SCOPE_MATCH",
        "score"
      ],
      "properties": {
        "target_id": { "type": "string", "pattern": "^T[0-9]{2}$" },
        "raw_output_sha256": { "$ref": "#/$defs/sha256" },
        "answer_key_sha256": { "$ref": "#/$defs/sha256" },
        "scope_rubric_sha256": { "$ref": "#/$defs/sha256" },
        "KEY_MATCH": { "type": "boolean" },
        "SCOPE_MATCH": { "type": "boolean" },
        "score": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "required": ["KEY_MATCH", "SCOPE_MATCH"],
            "properties": { "KEY_MATCH": { "const": true }, "SCOPE_MATCH": { "const": true } }
          },
          "then": { "properties": { "score": { "const": true } } },
          "else": { "properties": { "score": { "const": false } } }
        }
      ]
    },
    "run_identifiers_pre": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_id", "execution_state", "package_id", "target_id", "target_family", "condition_id", "invocation"],
      "properties": {
        "audit_id": { "type": "string", "minLength": 1 },
        "execution_state": { "const": "PRE_EXECUTION_NULL" },
        "package_id": { "type": "null" },
        "target_id": { "type": "null" },
        "target_family": { "type": "null" },
        "condition_id": { "type": "null" },
        "invocation": { "type": "null" }
      }
    },
    "run_identifiers_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_id", "execution_state", "package_id", "target_id", "target_family", "condition_id", "invocation"],
      "properties": {
        "audit_id": { "type": "string", "minLength": 1 },
        "execution_state": { "const": "SOURCE_EXECUTION_BOUND" },
        "package_id": { "type": "string", "pattern": "^SP0[1-8]$" },
        "target_id": { "type": "null" },
        "target_family": { "type": "null" },
        "condition_id": { "type": "string", "enum": ["C1", "C2", "C3", "C4"] },
        "invocation": { "const": "source" }
      }
    },
    "run_identifiers_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_id", "execution_state", "package_id", "target_id", "target_family", "condition_id", "invocation"],
      "properties": {
        "audit_id": { "type": "string", "minLength": 1 },
        "execution_state": { "const": "TARGET_EXECUTION_BOUND" },
        "package_id": { "type": "string", "pattern": "^SP0[1-8]$" },
        "target_id": { "type": "string", "pattern": "^T[0-9]{2}$" },
        "target_family": {
          "type": "string",
          "enum": ["structural_diagnosis", "constraint_aware_recommendation", "causal_explanation"]
        },
        "condition_id": { "type": "string", "enum": ["C1", "C2", "C3", "C4"] },
        "invocation": { "const": "target" }
      }
    },
    "pre_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_identifiers",
        "hashes",
        "token_accounting",
        "model_binding",
        "response",
        "evaluator",
        "condition_order",
        "credential_boundary",
        "operator_actions"
      ],
      "properties": {
        "run_identifiers": { "$ref": "#/$defs/run_identifiers_pre" },
        "hashes": { "$ref": "#/$defs/null_field" },
        "token_accounting": { "$ref": "#/$defs/null_field" },
        "model_binding": { "$ref": "#/$defs/null_field" },
        "response": { "$ref": "#/$defs/null_field" },
        "evaluator": { "$ref": "#/$defs/null_field" },
        "condition_order": { "$ref": "#/$defs/null_field" },
        "credential_boundary": { "$ref": "#/$defs/null_field" },
        "operator_actions": { "$ref": "#/$defs/null_field" }
      }
    },
    "source_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_identifiers",
        "hashes",
        "token_accounting",
        "model_binding",
        "response",
        "evaluator",
        "condition_order",
        "credential_boundary",
        "operator_actions",
        "scorer_image_sha256"
      ],
      "properties": {
        "run_identifiers": { "$ref": "#/$defs/run_identifiers_source" },
        "hashes": { "$ref": "#/$defs/hashes" },
        "token_accounting": { "$ref": "#/$defs/token_accounting" },
        "model_binding": { "$ref": "#/$defs/model_binding" },
        "response": { "$ref": "#/$defs/response" },
        "evaluator": { "type": "null" },
        "condition_order": { "$ref": "#/$defs/condition_order" },
        "credential_boundary": { "$ref": "#/$defs/credential_boundary" },
        "operator_actions": { "$ref": "#/$defs/operator_actions" },
        "scorer_image_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "target_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_identifiers",
        "hashes",
        "token_accounting",
        "model_binding",
        "response",
        "evaluator",
        "condition_order",
        "credential_boundary",
        "operator_actions",
        "scorer_image_sha256"
      ],
      "properties": {
        "run_identifiers": { "$ref": "#/$defs/run_identifiers_target" },
        "hashes": { "$ref": "#/$defs/hashes" },
        "token_accounting": { "$ref": "#/$defs/token_accounting" },
        "model_binding": { "$ref": "#/$defs/model_binding" },
        "response": { "$ref": "#/$defs/response" },
        "evaluator": { "$ref": "#/$defs/evaluator" },
        "condition_order": { "$ref": "#/$defs/condition_order" },
        "credential_boundary": { "$ref": "#/$defs/credential_boundary" },
        "operator_actions": { "$ref": "#/$defs/operator_actions" },
        "scorer_image_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
