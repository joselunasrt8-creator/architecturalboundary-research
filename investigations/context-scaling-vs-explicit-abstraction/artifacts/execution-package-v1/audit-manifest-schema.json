{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecturalboundary-research.example/schemas/context-abstraction-audit-manifest-v1.json",
  "title": "Context-abstraction execution audit manifest",
  "description": "Strict audit record for either the honest pre-execution NULL state or one execution-bound invocation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_identifiers",
    "hashes",
    "prompts",
    "package_ids",
    "target_ids",
    "tokenizer",
    "model_binding",
    "condition_order",
    "response_placeholders",
    "evaluator_placeholders",
    "environment_metadata",
    "credential_boundary",
    "operator_actions"
  ],
  "properties": {
    "run_identifiers": {},
    "hashes": {},
    "prompts": {},
    "package_ids": {},
    "target_ids": {},
    "tokenizer": {},
    "model_binding": {},
    "condition_order": {},
    "response_placeholders": {},
    "evaluator_placeholders": {},
    "environment_metadata": {},
    "credential_boundary": {},
    "operator_actions": {}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "null_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "NULL"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "request_sha256",
        "started_at",
        "ended_at",
        "http_status",
        "response_id"
      ],
      "properties": {
        "endpoint": {
          "const": "https://api.openai.com/v1/responses"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "http_status": {
          "type": "integer",
          "minimum": 200,
          "maximum": 299
        },
        "response_id": {
          "type": "string",
          "pattern": "^resp_[A-Za-z0-9]+$"
        }
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_sha256",
        "prompt_sha256",
        "request_sha256",
        "raw_response_sha256",
        "registry_sha256"
      ],
      "properties": {
        "package_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "raw_response_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "registry_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_prompt_sha256",
        "user_prompt_sha256",
        "rendered_prompt_sha256"
      ],
      "properties": {
        "system_prompt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "user_prompt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rendered_prompt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "endpoint",
        "decoding",
        "request"
      ],
      "properties": {
        "model": {
          "const": "gpt-4.1-2025-04-14"
        },
        "endpoint": {
          "const": "https://api.openai.com/v1/responses"
        },
        "decoding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "temperature",
            "top_p",
            "max_output_tokens",
            "presence_penalty",
            "frequency_penalty",
            "seed"
          ],
          "properties": {
            "temperature": {
              "const": 0
            },
            "top_p": {
              "const": 1
            },
            "max_output_tokens": {
              "const": 2048
            },
            "presence_penalty": {
              "const": 0
            },
            "frequency_penalty": {
              "const": 0
            },
            "seed": {
              "const": 20260719
            }
          }
        },
        "request": {
          "$ref": "#/$defs/request"
        }
      }
    },
    "tokenizer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "package",
        "encoding"
      ],
      "properties": {
        "name": {
          "const": "o200k_base"
        },
        "package": {
          "const": "tiktoken==0.9.0"
        },
        "encoding": {
          "const": "UTF-8 without normalization"
        }
      }
    },
    "condition_order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "position",
        "condition_id"
      ],
      "properties": {
        "stage": {
          "enum": [
            "source",
            "target"
          ]
        },
        "position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "condition_id": {
          "enum": [
            "C1",
            "C2",
            "C3",
            "C4"
          ]
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_response_sha256",
        "retained_output_sha256",
        "byte_length"
      ],
      "properties": {
        "raw_response_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "retained_output_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "raw_output_sha256",
        "answer_key_sha256",
        "scope_rubric_sha256",
        "KEY_MATCH",
        "SCOPE_MATCH",
        "score"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "pattern": "^T[0-9]{2,}$"
        },
        "raw_output_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "answer_key_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope_rubric_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "KEY_MATCH": {
          "type": "boolean"
        },
        "SCOPE_MATCH": {
          "type": "boolean"
        },
        "score": {
          "type": "boolean"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocation_image_sha256",
        "scoring_image_sha256",
        "network"
      ],
      "properties": {
        "invocation_image_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scoring_image_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "network": {
          "enum": [
            "controlled_api_only",
            "disabled"
          ]
        }
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "injected_for_invocation",
        "persisted",
        "request_count"
      ],
      "properties": {
        "injected_for_invocation": {
          "const": true
        },
        "persisted": {
          "const": false
        },
        "request_count": {
          "const": 1
        }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "recorded_at"
      ],
      "properties": {
        "action": {
          "enum": [
            "rendered",
            "invoked",
            "handed_off",
            "scored",
            "frozen"
          ]
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "oneOf": [
    {
      "title": "Pre-execution NULL determination",
      "properties": {
        "hashes": {
          "$ref": "#/$defs/null_record"
        },
        "prompts": {
          "$ref": "#/$defs/null_record"
        },
        "package_ids": {
          "$ref": "#/$defs/null_record"
        },
        "target_ids": {
          "$ref": "#/$defs/null_record"
        },
        "tokenizer": {
          "$ref": "#/$defs/null_record"
        },
        "model_binding": {
          "$ref": "#/$defs/null_record"
        },
        "condition_order": {
          "$ref": "#/$defs/null_record"
        },
        "response_placeholders": {
          "$ref": "#/$defs/null_record"
        },
        "evaluator_placeholders": {
          "$ref": "#/$defs/null_record"
        },
        "environment_metadata": {
          "$ref": "#/$defs/null_record"
        },
        "credential_boundary": {
          "$ref": "#/$defs/null_record"
        },
        "operator_actions": {
          "$ref": "#/$defs/null_record"
        },
        "run_identifiers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "audit_id",
            "execution_state",
            "package_id",
            "target_id",
            "condition_id"
          ],
          "properties": {
            "audit_id": {
              "type": "string",
              "pattern": "^audit-null-[a-z0-9-]+$"
            },
            "execution_state": {
              "const": "PRE_EXECUTION_NULL"
            },
            "package_id": {
              "type": "null"
            },
            "target_id": {
              "type": "null"
            },
            "condition_id": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "title": "Execution-bound audit record",
      "properties": {
        "run_identifiers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "audit_id",
            "execution_state",
            "package_id",
            "target_id",
            "condition_id",
            "invocation"
          ],
          "properties": {
            "audit_id": {
              "type": "string",
              "pattern": "^audit-[a-z0-9-]+$"
            },
            "execution_state": {
              "const": "EXECUTION_BOUND"
            },
            "package_id": {
              "type": "string",
              "pattern": "^SP0[1-8]$"
            },
            "target_id": {
              "type": "string",
              "pattern": "^T[0-9]{2,}$"
            },
            "condition_id": {
              "enum": [
                "C1",
                "C2",
                "C3",
                "C4"
              ]
            },
            "invocation": {
              "enum": [
                "source",
                "target"
              ]
            }
          }
        },
        "hashes": {
          "$ref": "#/$defs/hashes"
        },
        "prompts": {
          "$ref": "#/$defs/prompt"
        },
        "package_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "minItems": 1
        },
        "target_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^T[0-9]{2,}$"
          },
          "minItems": 1
        },
        "tokenizer": {
          "$ref": "#/$defs/tokenizer"
        },
        "model_binding": {
          "$ref": "#/$defs/model"
        },
        "condition_order": {
          "$ref": "#/$defs/condition_order"
        },
        "response_placeholders": {
          "$ref": "#/$defs/response"
        },
        "evaluator_placeholders": {
          "$ref": "#/$defs/evaluator"
        },
        "environment_metadata": {
          "$ref": "#/$defs/environment"
        },
        "credential_boundary": {
          "$ref": "#/$defs/credential"
        },
        "operator_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operator"
          },
          "minItems": 1
        }
      }
    }
  ]
}
