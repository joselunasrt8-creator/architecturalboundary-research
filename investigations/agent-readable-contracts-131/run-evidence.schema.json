{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecturalboundary.example/schemas/issue-131-run-evidence-v1.json",
  "title": "Issue 131 immutable run evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "condition", "task_id", "replicate", "repository_revision", "context_hashes", "prompt", "agent", "environment", "events", "output", "candidate_artifacts", "validation", "interventions", "resource_usage", "disposition"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "condition": {"enum": ["A", "B", "C"]},
    "task_id": {"enum": ["T1", "T2"]},
    "replicate": {"type": "integer", "minimum": 1, "maximum": 5},
    "repository_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "context_hashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "prompt": {"type": "string"},
    "agent": {"type": "object"},
    "environment": {"type": "object"},
    "events": {"type": "array", "items": {"type": "object"}},
    "output": {"type": ["string", "null"]},
    "candidate_artifacts": {"type": "array", "items": {"type": "object"}},
    "validation": {"type": "array", "items": {"type": "object"}},
    "interventions": {"type": "array", "items": {"type": "object"}},
    "resource_usage": {"type": "object"},
    "disposition": {"enum": ["VALID", "INVALID", "NULL", "BLOCKED", "TIMEOUT", "METHODOLOGY_FAILURE"]}
  }
}
