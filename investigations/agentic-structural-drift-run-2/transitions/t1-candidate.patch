index 0000000..38a692f
--- /dev/null
+++ b/tests/test_structural_snapshot.py
@@ -0,0 +1,44 @@
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+from scripts.structural_snapshot import snapshot
+
+
+def write(root: Path, relative: str, content: str) -> None:
+    path = root / relative
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(content, encoding="utf-8")
+
+
+def test_snapshot_discovers_internal_edges_and_ignores_external_imports(tmp_path):
+    write(tmp_path, "app/main.py", "import json\nfrom lib import helper\n")
+    write(tmp_path, "lib/helper.py", "import app.main\n")
+
+    result = snapshot(tmp_path)
+
+    assert result["nodes"] == ["app.main", "lib.helper"]
+    assert result["edges"] == [
+        {"from": "app.main", "to": "lib.helper"},
+        {"from": "lib.helper", "to": "app.main"},
+    ]
+
+
+def test_snapshot_order_is_stable(tmp_path):
+    write(tmp_path, "z.py", "import a\n")
+    write(tmp_path, "a.py", "")
+    assert snapshot(tmp_path) == snapshot(tmp_path)
+    assert snapshot(tmp_path)["nodes"] == ["a", "z"]
+
+
+def test_cli_emits_canonical_json(tmp_path):
+    write(tmp_path, "only.py", "")
+    completed = subprocess.run(
+        [sys.executable, "scripts/structural_snapshot.py", str(tmp_path)],
+        check=True,
+        cwd=Path(__file__).resolve().parents[1],
+        text=True,
+        stdout=subprocess.PIPE,
+    )
+    assert completed.stdout == json.dumps(snapshot(tmp_path), sort_keys=True, separators=(",", ":")) + "\n"
