@@ -0,0 +1,11 @@
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+
+from json_io import canonical_json_bytes
+
+
+def test_canonical_json_bytes_is_readable_and_newline_terminated():
+    assert canonical_json_bytes({"b": 2, "a": 1}) == b'{\n  "b": 2,\n  "a": 1\n}\n'
