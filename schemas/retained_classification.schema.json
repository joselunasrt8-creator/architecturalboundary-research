{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/architecturalboundary/retained_classification.schema.json",
  "title": "Canonical B2 Retained Classification Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type", "schema_version", "protocol_version", "investigation_id", "id", "classification_stage",
    "input_analysis_ref", "input_dataset_ref", "decision_rule_ref", "cohort_size", "row_ordering", "measurement_fields",
    "per_system_classifications", "cohort_classification", "lineage", "provenance", "generation"
  ],
  "properties": {
    "object_type": {"const": "CanonicalRetainedClassification"},
    "schema_version": {"const": "canonical-retained-classification-v1"},
    "protocol_version": {"const": "protocol-v1"},
    "investigation_id": {"const": "b2-governance-cohort"},
    "id": {"const": "retained-classification-b2-governance-cohort-i5"},
    "classification_stage": {"const": "B2 Retained Classification"},
    "input_analysis_ref": {"const": "investigations/b2-governance-cohort/analysis/b2-governance-cohort-i4.analysis.json"},
    "input_dataset_ref": {"const": "investigations/b2-governance-cohort/dataset/b2-governance-cohort-i4.dataset.json"},
    "decision_rule_ref": {"const": "investigations/b2-governance-cohort/preregistration/i1_i5_registration.json#/deterministic_decision_rule/I5"},
    "cohort_size": {"const": 9},
    "row_ordering": {"const": "system_id ascending"},
    "measurement_fields": {"type": "array", "items": {"enum": ["m_R", "m_L", "m_E", "m_RL", "m_LE"]}, "minItems": 5, "maxItems": 5, "uniqueItems": true},
    "per_system_classifications": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/systemClassification"}},
    "cohort_classification": {"type": "object", "additionalProperties": false, "required": ["outcome", "precedence", "basis"], "properties": {"outcome": {"enum": ["supports", "violates", "indeterminate"]}, "precedence": {"type": "array", "items": {"enum": ["indeterminate", "violates", "supports"]}, "minItems": 3, "maxItems": 3}, "basis": {"type": "array", "items": {"type": "string"}, "minItems": 1}}},
    "lineage": {"type": "object", "additionalProperties": false, "required": ["analysis_path", "dataset_path", "registration_path", "msr_paths", "der_paths", "srf_paths", "bor_paths"], "properties": {"analysis_path": {"type": "string"}, "dataset_path": {"type": "string"}, "registration_path": {"type": "string"}, "msr_paths": {"type": "array", "minItems": 9, "uniqueItems": true, "items": {"type": "string"}}, "der_paths": {"type": "array", "minItems": 9, "uniqueItems": true, "items": {"type": "string"}}, "srf_paths": {"type": "array", "minItems": 9, "uniqueItems": true, "items": {"type": "string"}}, "bor_paths": {"type": "array", "minItems": 9, "uniqueItems": true, "items": {"type": "string"}}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["method", "created_from"], "properties": {"method": {"const": "CanonicalAnalysis -> frozen I5 deterministic retained classification"}, "created_from": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "generation": {"type": "object", "additionalProperties": false, "required": ["builder", "mode", "repository_root"], "properties": {"builder": {"const": "scripts/build_retained_classification.py"}, "mode": {"const": "deterministic-rebuild"}, "repository_root": {"const": "."}}}
  },
  "$defs": {
    "measurement_value": {"type": ["integer", "null"], "enum": [0, 1, null]},
    "systemClassification": {"type": "object", "additionalProperties": false, "required": ["system_id", "msr_id", "measurements", "classification", "missing_measurements", "lineage"], "properties": {"system_id": {"type": "string", "minLength": 1}, "msr_id": {"type": "string", "minLength": 1}, "measurements": {"type": "object", "additionalProperties": false, "required": ["m_R", "m_L", "m_E", "m_RL", "m_LE"], "properties": {"m_R": {"$ref": "#/$defs/measurement_value"}, "m_L": {"$ref": "#/$defs/measurement_value"}, "m_E": {"$ref": "#/$defs/measurement_value"}, "m_RL": {"$ref": "#/$defs/measurement_value"}, "m_LE": {"$ref": "#/$defs/measurement_value"}}}, "classification": {"enum": ["supports", "violates", "indeterminate"]}, "missing_measurements": {"type": "array", "items": {"enum": ["m_R", "m_L", "m_E", "m_RL", "m_LE"]}, "uniqueItems": true}, "lineage": {"type": "object", "additionalProperties": false, "required": ["analysis_ref", "dataset_ref", "msr_path", "source_der_ids", "der_paths", "srf_paths", "bor_paths", "decision_rule_ref"], "properties": {"analysis_ref": {"type": "string"}, "dataset_ref": {"type": "string"}, "msr_path": {"type": "string"}, "source_der_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "der_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "srf_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "bor_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "decision_rule_ref": {"type": "string"}}}}}
  }
}
